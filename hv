8) INSTALL AND CONFIGURE LOAD BALANCER
--------------------------------------
# On the Load Balancer VM:
sudo apt update
sudo apt install -y nginx
sudo nano /etc/nginx/nginx.conf

# Add the following INSIDE the existing http { } block.
# Replace BACKEND1_IP and BACKEND2_IP with real backend IP addresses.

upstream backend_servers {
    server BACKEND1_IP:80;
    server BACKEND2_IP:80;
}

server {
    listen 8080;

    location / {
        proxy_pass http://backend_servers;
    }
}

# Test and reload:
sudo nginx -t
sudo systemctl enable --now nginx
sudo systemctl reload nginx

