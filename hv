5) INSTALL KVM/LIBVIRT/SSH (BOTH HOSTS)
---------------------------------------
sudo apt update
sudo apt install -y qemu-kvm libvirt-daemon-system libvirt-clients bridge-utils virtinst openssh-server
sudo systemctl enable --now libvirtd
sudo systemctl enable --now ssh
sudo usermod -aG libvirt "$USER"
sudo usermod -aG kvm "$USER"

# Log out and back in, then:
lsmod | grep kvm
sudo systemctl status libvirtd
sudo virsh list --all

6) OPTIONAL: CREATE A NESTED VM
-------------------------------
# Ensure this ISO exists first:
ls -l /var/lib/libvirt/images/ubuntu.iso

# On Host1:
sudo virt-install \
  --name test-vm1 \
  --memory 2048 \
  --vcpus 2 \
  --disk size=15 \
  --cdrom /var/lib/libvirt/images/ubuntu.iso \
  --network network=default \
  --graphics none \
  --noautoconsole

# On Host2, change the VM name to test-vm2 and run the same command.
sudo virsh list --all

